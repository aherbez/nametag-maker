{
  "name": "nametag-maker",
  "productName": "Nametag Maker",
  "version": "0.1.0",
  "author": "Adrian Herbez <aherbez@gmail.com>",
  "description": "A tool for creating 3d printable nametags",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --mac"
  },
  "build": {
    "appId": "net.adrianherbez.nametag-maker",
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@mui/material": "^7.3.7",
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "opentype.js": "^1.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
